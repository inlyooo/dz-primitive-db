[36.38904619216919,"o","\u001b[?25l\u001b[m***База данных***\u001b[15;1HУправление таблицами:\r\n  create_table <таблица> <столбец:тип> ... — создать таблицу\r\n  list_tables — показать список таблиц\r\n  drop_table <таблица> — удалить таблицу\r\n  info <таблица> — показать структуру и число записей\u001b[21;1HОперации с данными:\r\n  insert into <таблица> values (<значение>, ...) — добавить запись\r\n  select from <таблица> [where <столбец> = <значение>] — прочитать записи\r\n  update <таблица> set <столбец> = <значение> where <столбец> = <значение>\r\u001b[?25h\n  delete from <таблица> where <столбец> = <значение> — удалить записи\r\n\nТипы: int, str, bool. Строки вводите в кавычках, bool — true или false.\r\nID генерируется авто"]
[36.38998532295227,"o","матически. Для update и delete условие обязательно.\r\n  help — справка\r\n  exit — выход\r"]
[36.39017677307129,"o","\n"]
[36.397902488708496,"o","\n>>>Введите команду:\u001b[1C"]
[50.86769771575928,"o","c"]
[50.87415671348572,"o","reate_table users name:str age:int is_active:bool\r"]
[50.87889790534973,"o","\nТаблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_acti\r\n\u001b[23;80Hive:bool\r"]
[50.87916612625122,"o","\n>>>Введите команду: list_tables\r"]
[50.88047528266907,"o","\n"]
[50.88054442405701,"o","- users\r"]
[50.88208508491516,"o","\n>>>Введите команду: insert into users values (\"Sergei\", 28, true)\r"]
[50.884188652038574,"o","\nФункция insert выполнилась за 0.000 секунд.\r"]
[50.886510372161865,"o","\nЗапись с ID=1 успешно добавлена в таблицу \"users\".\r"]
[50.88882255554199,"o","\n>>>Введите команду: insert into users values (\"Anna Maria\", 24, fals"]
[50.88939809799194,"o","e)\r"]
[50.891915798187256,"o","\nФункция insert выполнилась за 0.000 секунд.\r"]
[50.89450478553772,"o","\nЗапись с ID=2 успешно добавлена в таблицу \"users\".\r"]
[50.89477348327637,"o","\n>>>Введите команду: select from users\r"]
[50.89929723739624,"o","\n"]
[50.90433406829834,"o","Функция select выполнилась за 0.000 секунд.\r"]
[50.91053223609924,"o","\n"]
[51.54333162307739,"o","+----+------------+-----+-----------+\r\n| ID |    name    | age | is_active |\r\n+----+------------+-----+-----------+\r\n| 1  |   Sergei   |  28 |    True   |\r\n| 2  | Anna Maria |  24 |   False   |\r"]
[51.54361701011658,"o","\n+----+------------+-----+-----------+"]
[51.54365658760071,"o","\r"]
[51.56401348114014,"o","\n>>>Введите команду:\u001b[1C"]
